{
  "info": {
    "name": "Relay \u2014 API walkthrough",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Cookies are kept automatically. Fill adminPassword / icPassword from .data/credentials-*.json, then run top to bottom. In Postman use a cookie jar per role: sign in as one role at a time."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3001"
    },
    {
      "key": "adminEmail",
      "value": "admin@relay.example"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "icEmail",
      "value": "ic@relay.example"
    },
    {
      "key": "icPassword",
      "value": ""
    },
    {
      "key": "csrfToken",
      "value": ""
    },
    {
      "key": "icId",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "caseId",
      "value": ""
    },
    {
      "key": "revision",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Sign in",
      "item": [
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json(); pm.collectionVariables.set('csrfToken', b.csrfToken); pm.collectionVariables.set('adminId', b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Current account",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          }
        },
        {
          "name": "List team (find the consultant id)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ic = pm.response.json().find(u => u.role === 'ic'); pm.collectionVariables.set('icId', ic.id);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2 \u00b7 Configure AI (once)",
      "item": [
        {
          "name": "Test an OpenRouter key before saving",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings/ai/test",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings",
                "ai",
                "test"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"sk-or-v1-\\u2026\",\n  \"model\": \"nvidia/nemotron-3-super-120b-a12b:free\"\n}"
            }
          }
        },
        {
          "name": "Save key + options",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings/ai",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings",
                "ai"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"sk-or-v1-\\u2026\",\n  \"model\": \"nvidia/nemotron-3-super-120b-a12b:free\",\n  \"shareSamples\": false,\n  \"minConfidence\": 0.85\n}"
            }
          }
        },
        {
          "name": "Read settings (key is never returned)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings"
              ]
            }
          }
        },
        {
          "name": "List free models",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/settings/ai/models",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "settings",
                "ai",
                "models"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3 \u00b7 Migrate",
      "item": [
        {
          "name": "Understand a target: names only",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/configuration/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "configuration",
                "validate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema\": \"employee_id, full_name, email, start_date, salary\"\n}"
            }
          }
        },
        {
          "name": "Understand a target: names + types (! = required)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/configuration/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "configuration",
                "validate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema\": {\n    \"sku\": \"string!\",\n    \"price\": \"number!\",\n    \"stock\": \"whole number\"\n  }\n}"
            }
          }
        },
        {
          "name": "Understand a target: sample record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/configuration/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "configuration",
                "validate"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schema\": {\n    \"id\": \"C-1\",\n    \"email\": \"a@b.co\",\n    \"spend\": 48250.75,\n    \"active\": true\n  }\n}"
            }
          }
        },
        {
          "name": "Ready-made targets",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/presets",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "presets"
              ]
            }
          }
        },
        {
          "name": "Preview files (nothing is created)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/sources/preview",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "sources",
                "preview"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/04-helix/hr-core.xlsx"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/04-helix/legacy-crm.xlsx"
                }
              ]
            }
          }
        },
        {
          "name": "Generate \u2014 built-in mock API, Employee preset",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Helix via Postman",
                  "type": "text"
                },
                {
                  "key": "assignedTo",
                  "value": "{{icId}}",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/04-helix/hr-core.xlsx"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/04-helix/legacy-crm.xlsx"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('runId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Generate \u2014 your own mock API URL",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "Helix to my endpoint",
                  "type": "text"
                },
                {
                  "key": "assignedTo",
                  "value": "{{icId}}",
                  "type": "text"
                },
                {
                  "key": "configuration",
                  "value": "{\"schema\": \"\\u2026paste a schema\\u2026\", \"identityField\": \"employee_id\", \"destination\": {\"kind\": \"http\", \"url\": \"https://your-mock.example/employees\"}}",
                  "type": "text"
                },
                {
                  "key": "authorization",
                  "value": "Bearer optional",
                  "type": "text"
                },
                {
                  "key": "files",
                  "type": "file",
                  "src": "samples/04-helix/hr-core.xlsx"
                }
              ]
            }
          }
        },
        {
          "name": "Poll the migration (status, mappings, cases, escalation)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json(); pm.collectionVariables.set('revision', r.revision); if (r.cases[0]) pm.collectionVariables.set('caseId', r.cases[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Summary",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "summary"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "4 \u00b7 Consultant reviews (sign in as ic first)",
      "item": [
        {
          "name": "Sign in as ic",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{icEmail}}\",\n  \"password\": \"{{icPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json(); pm.collectionVariables.set('csrfToken', b.csrfToken); pm.collectionVariables.set('icId', b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Read the case",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json(); pm.collectionVariables.set('revision', r.revision); pm.collectionVariables.set('caseId', r.cases[0].id); console.log(r.cases[0]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Approve / correct a case",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "resolve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"expectedRevision\": \"{{revision}}\",\n  \"decision\": {\n    \"action\": \"correct\",\n    \"value\": \"2024-05-04\",\n    \"reason\": \"Client confirmed day/month order.\"\n  }\n}"
            }
          }
        },
        {
          "name": "Ignore a column",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "resolve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"expectedRevision\": \"{{revision}}\",\n  \"decision\": {\n    \"action\": \"ignore\",\n    \"reason\": \"Not part of the target schema.\"\n  }\n}"
            }
          }
        },
        {
          "name": "Reject a record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "resolve"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caseId\": \"{{caseId}}\",\n  \"expectedRevision\": \"{{revision}}\",\n  \"decision\": {\n    \"action\": \"reject\",\n    \"reason\": \"Obsolete record per the client.\"\n  }\n}"
            }
          }
        },
        {
          "name": "Consultant may NOT roll back (403)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/rollback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "rollback"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "5 \u00b7 Verify and recover (sign in as admin)",
      "item": [
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const b = pm.response.json(); pm.collectionVariables.set('csrfToken', b.csrfToken); pm.collectionVariables.set('adminId', b.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "What the mock API received",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mock/records",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mock",
                "records"
              ]
            }
          }
        },
        {
          "name": "Make the next write fail",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/mock/fail-next",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "mock",
                "fail-next"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"count\": 1\n}"
            }
          }
        },
        {
          "name": "Retry outstanding records",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "retry"
              ]
            }
          }
        },
        {
          "name": "Delivery JSON",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/payload",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "payload"
              ]
            }
          }
        },
        {
          "name": "Audit export",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/audit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "audit"
              ]
            }
          }
        },
        {
          "name": "Roll back",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-csrf-token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/runs/{{runId}}/rollback",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "runs",
                "{{runId}}",
                "rollback"
              ]
            }
          }
        }
      ]
    }
  ]
}
