{
  "name": "relay-migration-agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/e2e.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "format": "prettier --write \"{src,server,tests,scripts}/**/*.{ts,tsx,css}\" \"*.{json,ts}\"",
    "format:check": "prettier --check \"{src,server,tests,scripts}/**/*.{ts,tsx,css}\" \"*.{json,ts}\"",
    "users:seed": "tsx scripts/seed-users.ts",
    "mock:start": "tsx scripts/mock-api.ts",
    "samples": "tsx scripts/make-samples.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  },
  "description": "AI-assisted employee data migration agent: maps and cleans multi-file exports, escalates only real uncertainty to a person, and delivers to an HTTP API with idempotent retry and rollback."
}
